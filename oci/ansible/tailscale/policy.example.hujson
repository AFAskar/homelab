// Merge into existing policy; do not replace existing tailnet policy.
// Replace OCI CIDRs/IPs after discovery. Route approval is separate from grants.
{
  "tagOwners": {"tag:oci-router": ["autogroup:admin"]},
  "groups": {"group:oci-admins": ["REPLACE_ADMIN_LOGIN"]},
  "grants": [
    {"src": ["group:oci-admins"], "dst": ["REPLACE_LINUX_PRIVATE_IPS"], "ip": ["tcp:22", "tcp:8080", "tcp:2022", "tcp:9100"]},
    {"src": ["group:oci-admins"], "dst": ["REPLACE_WINDOWS_PRIVATE_IP"], "ip": ["tcp:3389"]},
    {"src": ["100.114.113.82", "100.77.7.115"], "dst": ["REPLACE_WINGS_PRIVATE_IPS"], "ip": ["tcp:8080", "tcp:9100"]}
  ]
}
