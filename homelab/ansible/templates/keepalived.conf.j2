global_defs {
    enable_script_security
    script_user root
}
vrrp_script homelab_services {
    script "/usr/local/sbin/homelab-ha-health"
    interval 5
    timeout 4
    fall 2
    rise 2
}
vrrp_instance HOMELAB {
    state BACKUP
    interface {{ node_interface }}
    virtual_router_id {{ ha_virtual_router_id }}
    priority {{ ha_priority }}
    advert_int 1
    nopreempt
    unicast_src_ip {{ node_ip }}
    unicast_peer {
{% for peer in groups.api_frontends if peer != inventory_hostname %}
        {{ hostvars[peer].node_ip }}
{% endfor %}
    }
    virtual_ipaddress {
        {{ ha_virtual_ip }}/{{ ha_virtual_prefix }} dev {{ node_interface }}
    }
    track_script {
        homelab_services
    }
}
