#!/usr/bin/env bash
set -euo pipefail
# Scoped chains, no global flush. Restrict before OCI broad rules are removed.
for chain in PELICAN-IN PELICAN-FWD; do
  iptables -N "$chain" 2>/dev/null || true
  iptables -F "$chain"
done
iptables -A PELICAN-IN -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
iptables -A PELICAN-IN -i lo -j ACCEPT
{% for cidr in admin_source_cidrs %}
iptables -A PELICAN-IN -s {{ cidr }} -p tcp --dport 22 -j ACCEPT
{% endfor %}
{% for cidr in router_source_cidrs %}
iptables -A PELICAN-IN -s {{ cidr }} -p tcp -m multiport --dports 8080,2022,9100 -j ACCEPT
{% endfor %}
# Traffic addressed to the router itself arrives on tailscale0 before SNAT.
{% if inventory_hostname in groups.get('subnet_routers', []) %}
# Preserve the existing direct tailnet SSH path until independently retired.
{% for cidr in panel_callback_source_cidrs | default(['10.10.50.0/24']) %}
iptables -A PELICAN-IN -d {{ router_private_ip }} -s {{ cidr }} -p tcp --dport 443 -j ACCEPT
{% endfor %}
{% for cidr in router_tailnet_admin_sources %}
iptables -A PELICAN-IN -i tailscale0 -s {{ cidr }} -p tcp -m multiport --dports 22,8080,2022,9100 -j ACCEPT
{% endfor %}
{% for cidr in router_tailnet_service_sources | default(['100.114.113.82/32', '100.77.7.115/32']) %}
iptables -A PELICAN-IN -i tailscale0 -s {{ cidr }} -p tcp -m multiport --dports 8080,9100 -j ACCEPT
{% endfor %}
{% endif %}
iptables -A PELICAN-IN -p tcp -m multiport --dports 22,8080,2022,9100,3389 -j DROP
iptables -A PELICAN-IN -j RETURN
iptables -C INPUT -j PELICAN-IN 2>/dev/null || iptables -I INPUT 1 -j PELICAN-IN
iptables -A PELICAN-FWD -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
{% for port in wings_game_tcp_ports %}
iptables -A PELICAN-FWD -i {{ wings_public_interface }} -p tcp -m conntrack --ctorigdstport {{ port }} -j RETURN
{% endfor %}
{% for port in wings_game_udp_ports %}
iptables -A PELICAN-FWD -i {{ wings_public_interface }} -p udp -m conntrack --ctorigdstport {{ port }} -j RETURN
{% endfor %}
# Drop only traffic forwarded from public NIC to Docker bridges; subnet routing
# and container egress remain available. DOCKER-USER runs before Docker accepts.
iptables -A PELICAN-FWD -i {{ wings_public_interface }} -o docker0 -j DROP
iptables -A PELICAN-FWD -i {{ wings_public_interface }} -o 'br+' -j DROP
iptables -A PELICAN-FWD -j RETURN
iptables -C DOCKER-USER -j PELICAN-FWD 2>/dev/null || iptables -I DOCKER-USER 1 -j PELICAN-FWD
# Prevent IPv6 bypass of private administrative services too.
ip6tables -N PELICAN6-IN 2>/dev/null || true
ip6tables -F PELICAN6-IN
ip6tables -A PELICAN6-IN -i lo -j RETURN
ip6tables -A PELICAN6-IN -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
ip6tables -A PELICAN6-IN -p tcp -m multiport --dports 22,8080,2022,9100,3389 -j DROP
ip6tables -A PELICAN6-IN -j RETURN
ip6tables -C INPUT -j PELICAN6-IN 2>/dev/null || ip6tables -I INPUT 1 -j PELICAN6-IN
