#!/sbin/openrc-run
description="Homelab k3s server"
supervisor=supervise-daemon
command="/usr/local/bin/k3s"
command_args="server --config /etc/rancher/k3s/config.yaml"
pidfile="/run/k3s.pid"
output_log="/var/log/k3s.log"
error_log="/var/log/k3s.log"
respawn_delay=5
respawn_max=0
{% if inventory_hostname == 'rpi4' %}
# Node exporter uses HostToContainer propagation for its read-only root mount.
start_pre() {
    /bin/mount --make-rshared /
}
{% endif %}
depend() {
    need net
    want cgroups
    after firewall
}
