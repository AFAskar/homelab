<network>
  <name>lab</name>
  <!-- nftables owns the policy; libvirt must not add an overlapping NAT firewall. -->
  <forward mode='open'/>
  <bridge name='{{ lab_bridge }}' stp='on' delay='0'/>
  <dns>
    <forwarder addr='1.1.1.1'/>
    <forwarder addr='9.9.9.9'/>
  </dns>
  <ip address='{{ lab_gateway_ip }}' netmask='255.255.255.0'>
    <dhcp><host mac='52:54:00:10:11:01' ip='192.168.124.10'/></dhcp>
  </ip>
</network>
